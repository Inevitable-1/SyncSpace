{
  "openapi": "3.0.3",
  "info": {
    "title": "SyncSpace API",
    "version": "1.0.0",
    "description": "Real-time collaborative workspace platform API.\n\nProvides authentication, workspaces, rooms, tasks, files, meetings, whiteboards, chat, and real-time collaboration via Socket.IO.",
    "contact": {
      "name": "Inevitable-1",
      "url": "https://github.com/Inevitable-1/SyncSpace"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Health check"
    },
    {
      "name": "Auth",
      "description": "Authentication & registration"
    },
    {
      "name": "Profile",
      "description": "User profile management"
    },
    {
      "name": "Workspaces",
      "description": "Workspace CRUD & membership"
    },
    {
      "name": "Rooms",
      "description": "Room management within workspaces"
    },
    {
      "name": "Tasks",
      "description": "Task management"
    },
    {
      "name": "Files",
      "description": "File upload & management"
    },
    {
      "name": "Meetings",
      "description": "Meeting scheduling"
    },
    {
      "name": "Activities",
      "description": "Activity feed"
    },
    {
      "name": "Notifications",
      "description": "User notifications"
    },
    {
      "name": "Chat",
      "description": "Real-time chat"
    },
    {
      "name": "Dashboard",
      "description": "Dashboard aggregated data"
    },
    {
      "name": "Members",
      "description": "Workspace member management"
    },
    {
      "name": "Invites",
      "description": "Workspace invitation system"
    },
    {
      "name": "Whiteboards",
      "description": "Whiteboard collaboration"
    },
    {
      "name": "Documents",
      "description": "Code document editing"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "avatar": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "isEmailVerified": {
            "type": "boolean"
          }
        }
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isPublic": {
            "type": "boolean"
          },
          "inviteCode": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Room": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "whiteboard",
              "code",
              "file",
              "chat"
            ]
          },
          "workspace": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "workspace": {
            "type": "string"
          },
          "room": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in-progress",
              "review",
              "done"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent"
            ]
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checklist": {
            "type": "array"
          }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "info",
              "success",
              "warning",
              "error"
            ]
          },
          "isRead": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Activity": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "action": {
            "type": "string"
          },
          "entityType": {
            "type": "string"
          },
          "entityId": {
            "type": "string"
          },
          "entityName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContributionScore": {
        "type": "object",
        "properties": {
          "score": {
            "type": "integer"
          },
          "level": {
            "type": "integer"
          },
          "nextLevelAt": {
            "type": "integer"
          },
          "progress": {
            "type": "number"
          },
          "badges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "breakdown": {
            "type": "object",
            "properties": {
              "workspacesCreated": {
                "type": "integer"
              },
              "roomsCreated": {
                "type": "integer"
              },
              "filesUploaded": {
                "type": "integer"
              },
              "meetingsCreated": {
                "type": "integer"
              },
              "invitesSent": {
                "type": "integer"
              },
              "tasksCreated": {
                "type": "integer"
              },
              "totalActivities": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new user",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "name",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "name": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Verification email sent"
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/api/auth/verify-email": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Verify email with token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verified"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/auth/set-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Set initial password after verification",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "password"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account created"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login with email and password",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout and clear session",
        "responses": {
          "200": {
            "description": "Logged out"
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Request password reset email",
