                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "delete": {
        "tags": [
          "Profile"
        ],
        "summary": "Delete account",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
