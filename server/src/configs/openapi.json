            "description": "Success"
          }
        }
      },
      "put": {
        "tags": [
          "Profile"
        ],
        "summary": "Update profile (name, avatar, bio)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
